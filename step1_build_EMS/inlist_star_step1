&star_job

   history_columns_file = '../inlists/history_columns_common.list'  ! a list of columns to save in the history files; common value: '' | read common list
   profile_columns_file = '../inlists/profile_columns_common.list'  ! a list of columns to save in the profile files; common value: '' | read common list

!!! modifications to model

   create_pre_main_sequence_model = .true.
   show_log_description_at_start = .true.

   write_profile_when_terminate = .true. !this is done in the run_star_extras.f
   filename_for_profile_when_terminate = 'step1_final_profile.data'

   save_model_when_terminate = .true.
   save_model_filename = 'step1_final.mod' 

   ! set initial age and model number to 0 again
   set_initial_age = .true.
   initial_age = 0
   set_initial_model_number = .true.
   initial_model_number = 0

   !network
   change_net = .true.
   new_net_name = 'sagb_NeNa_MgAl.net'
   show_net_species_info = .true.


   new_rotation_flag = .true.
   change_rotation_flag = .true.
   set_initial_surface_rotation_v = .true.

   ! display on-screen plots
   pgstar_flag = .false.

/ ! end of star_job namelist

&eos

!!! equation of state (EOS)
   Z_all_OPAL = 1.0d-4
   Z_all_HELM = 1.0d-4
   logT_min_FreeEOS_hi = 2.8d0
   logT_min_FreeEOS_lo = 3.1d0
   logQ_min_FreeEOS_hi = -8.0d0
   logQ_min_FreeEOS_lo = -10.0d0

/ ! end of eos namelist

&kap

!!! opacities
   Zbase = 1d-4
   
   kap_file_prefix = 'a09' 
   kap_lowT_prefix = 'lowT_fa05_a09p'
   kap_CO_prefix = 'a09_co' 

   use_Type2_opacities = .true.
   kap_Type2_full_off_X = 1.0d-3
   kap_Type2_full_on_X = 1.0d-6
   cubic_interpolation_in_X = .true.
   cubic_interpolation_in_Z = .true.

/ ! end of kap namelist

&controls
   ! see $MESA_DIR/star/defaults/controls.defaults and ../inlists/inlist_star_common

   use_dPrad_dm_form_of_T_gradient_eqn = .true.  ! enable to use a more dynimical equation to get temperature gradient; common value: .false. | hydrostatic values might not be appropriate
   
   initial_mass = 0.7d0
   initial_z = 1d-4
   initial_y = -1

   warn_when_large_rel_run_E_err = 1d99
   use_gold_tolerances = .false.
   energy_eqn_option = 'dedt'
   max_abs_rel_run_E_err = -1

   !OUTPUT OPTIONS
   history_interval = 1
   profile_interval = 10
   max_num_profile_models = 100 
   terminal_interval = 10
   write_header_frequency = 100
   photo_digits = 4
   photo_interval = 100
   

   star_history_dbl_format = '(1pes32.16e3, 1x)'
   star_history_int_format = '(i32, 1x)'
   star_history_txt_format = '(a32, 1x)'

   star_history_name = 'history.data'
   write_profiles_flag = .true.

   !PHYSICS
   !atmosphere
   Pextra_factor = 2.0d0

   !CONVECTION + MIXING
   use_Ledoux_criterion = .true.
   do_conv_premix = .true.
   conv_premix_avoid_increase = .true.

   mixing_length_alpha = 1.93d0
   mlt_option = 'Mihalas'
   mlt_use_rotation_correction = .false.

   use_superad_reduction = .false.
   okay_to_reduce_gradT_excess = .false.
   alpha_semiconvection = 0d0
   mixing_D_limit_for_log = 1d-50

   thermohaline_coeff = 17.5d0 
   num_cells_for_smooth_gradL_composition_term = 0

   !ROTATION
   w_div_wcrit_max = 0.9d0


   !MASS LOSS
   use_other_wind= .false. 
   cool_wind_full_on_T = 0.8d4  
   hot_wind_full_on_T = 1.2d4
   RGB_to_AGB_wind_switch = 1.0d-4
   hot_wind_scheme = 'Dutch' 
   cool_wind_RGB_scheme ='Dutch'
   cool_wind_AGB_scheme = 'Blocker' 
   Dutch_scaling_factor = 0 !1.0d0
   Blocker_scaling_factor = 0 !0.2d0
   Reimers_scaling_factor = 0 !0.1d0


   
   

   !DIFFUSION
   do_element_diffusion = .false. 
   diffusion_dt_limit = 3.15d9 
   diffusion_min_T_at_surface = 1.0d3
   diffusion_min_dq_at_surface = 1.0d-3
   diffusion_gamma_full_on = 165d0
   diffusion_gamma_full_off = 175d0
   diffusion_use_full_net = .true.

   !CORE MASS DEFINITION
   he_core_boundary_h1_fraction = 1d-2
   co_core_boundary_he4_fraction = 1d-1
   one_core_boundary_he4_c12_fraction = 1d-1
   min_boundary_fraction = 1d-1


   !MESH AND TIMESTEP PARAMETERS
   mesh_delta_coeff = 2.0d0
   varcontrol_target = 1d-3
   max_timestep_factor = 1.2d0
   max_allowed_nz = 20000
   max_dq = 2d-3
   solver_iters_timestep_limit = 20

   delta_XH_cntr_limit = 0.005d0
   delta_XH_cntr_hard_limit = -1

   delta_XHe_cntr_limit = 0.01d0
   delta_XHe_cntr_hard_limit = -1

   delta_XC_cntr_limit = 0.002d0
   delta_XC_cntr_hard_limit = -1

   ! From Frank's suggestions
   delta_lgT_cntr_limit   = 0.005d0   
   delta_lgT_limit = 0.025d0         
   delta_lgRho_cntr_limit = 0.025d0   
   delta_lgRho_limit = 0.5d0          

   delta_lgL_He_limit = 0.1d0

   ! time step resolution on fuel depletion
   delta_lg_XHe_cntr_limit = 0.01d0
   delta_lg_XHe_cntr_max   = 0.0d0
   delta_lg_XHe_cntr_min   = -4.0d0
   delta_lg_XHe_cntr_hard_limit = 0.02d0
   delta_lg_XC_cntr_limit = 0.01d0
   delta_lg_XC_cntr_max   = 0.0d0
   delta_lg_XC_cntr_min   = -2.0d0 
   delta_lg_XC_cntr_hard_limit = 0.02d0
   delta_lg_XO_cntr_limit = 0.01d0
   delta_lg_XO_cntr_max   = 0.0d0
   delta_lg_XO_cntr_min   = -3.0d0
   delta_lg_XO_cntr_hard_limit = 0.02d0

   !limit changes in the timestep
   timestep_factor_for_retries = 0.75d0

   ! HRD, Radius resolution
   delta_HR_ds_L = 0.125d0
   delta_HR_ds_Teff = 2.0d0
   delta_HR_limit = 0.1d0
   delta_HR_hard_limit = 0.2d0


   ! WHEN TO STOP
   star_mass_max_limit = 1.0d3   ! desired mass of the extremly massive star


   ! for single stars stars, the control below needs to be true, so that the carbon exhaustion check happens in run_star_extras.f
   x_logical_ctrl(1) = .true.
   ! for formation of He single stars, before they later evolve in a CO-HeMS binary or in a He Star
   x_logical_ctrl(2) = .false.
   ! turn on eq.8 Belczynski+2010 LBV2 winds  with factor 1 (10-4 Msun/yr) to replace other winds for postMS stars in Humphreys-Davidson limit
   x_logical_ctrl(3) = .false.

   ! allows accretion from Haemmerlé et al.(2016)
   x_logical_ctrl(4) = .true. 
   use_other_adjust_mdot = .true.
   ! multiplicative factor for the accretion rate given by Haemmerle et al. (2016)
   x_ctrl(6) = 10.0d0 

   ! turn on the hot accretion scheme by Kuffmeier et al. 2018, see eq. (1) there
   x_logical_ctrl(5) = .false.
   ! value of the epsilon parameter from eq. (1)
   x_ctrl(5) = 0.0d0  
   ! minimum radial coord. [Rsun] to deposit the heat from the accreted material          
   x_ctrl(7) = 10.0d0
   ! allow for energy injection during accretion
   use_other_energy = .false.
   

/ ! end of controls namelist

