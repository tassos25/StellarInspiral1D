&star_job
   history_columns_file = '../inlists/history_columns_common.list'  ! a list of columns to save in the history files; common value: '' | read common list
   profile_columns_file = '../inlists/profile_columns_common.list'  ! a list of columns to save in the profile files; common value: '' | read common list

   create_pre_main_sequence_model = .true.                           ! create a starting model with uniform composition, a core temperature below 10^6 K;         default: .false.  |
   write_profile_when_terminate = .true.                             ! enable to write profiles on termination;                   default: .false.     | for step1: this is done in the POSYDON_run_binary_extras.f90
   filename_for_profile_when_terminate = 'step1_final_profile.data'  ! name of the final profile file;                            default: ''          | for step1: this is done in the POSYDON_run_binary_extras.f90

   save_model_filename = 'step1_final.mod'                           ! filename to save model;                                    default: 'undefined' | name get changed from Scotti's script

!!! modifications to model

   show_log_description_at_start = .true.                            ! enable initial terminal output;                            default: .true.      | turned off

   write_profile_when_terminate = .true.                             ! enable to write profiles on termination;                   default: .false.     | for step1: this is done in the POSYDON_run_binary_extras.f90
   filename_for_profile_when_terminate = 'step1_final_profile.data'  ! name of the final profile file;                            default: ''          | for step1: this is done in the POSYDON_run_binary_extras.f90

   save_model_filename = 'step1_final.mod'                           ! filename to save model;                                    default: 'undefined' | name get changed from Scotti's script

   change_net = .true.                                               ! enable to set the reaction network;  default: .false. | use different reaction network
   new_net_name = 'sagb_NeNa_MgAl.net'                               ! name of predefined reaction network; default: ''      |
   show_net_species_info = .true.            

   file_for_uniform_xa = 'new_abundaces_center.data'  !Changed
   set_uniform_initial_xa_from_file = .true.

   change_v_flag = .true.                                            ! copy enable velocity for each shell;                 common value: .false. | enables next setting
   new_v_flag = .false.                                              ! enable velocity for each shell;                      common value: .false. | enable differential rotation taken from previous model

   new_rotation_flag = .true.                                        ! enable rotation;                                      default: .false. |
   change_rotation_flag = .true.                                     ! copy enabled rotation;                                default: .false. | copy rotation flag
   set_initial_surface_rotation_v = .true.                           ! enable to set the initial rotation;                   default: .false. |

/ ! end of star_job namelist

&eos

!!! equation of state (EOS)
   Z_all_OPAL = 1.0d-4                                                  ! Use only OPAL tables if Z is greater than this number;                   default: 0.035d0 |
   Z_all_HELM = 1.0d-4                                                  ! Use only HELM tables if Z is less than this number;                      default: 0.040d0 |
   logT_min_FreeEOS_hi = 2.8d0                                          ! Use only FreeEOS tables if T is greater than this number;                default: 3.1d0   |
   logT_min_FreeEOS_lo = 3.1d0                                          ! Do not use FreeEOS tables if T is less than this number;                 default: 3.0d0   |
   logQ_min_FreeEOS_hi = -8.0d0                                         ! Use only FreeEOS tables if Q is greater than this number;                default: -9.9d0  |
   logQ_min_FreeEOS_lo = -10.0d0                                        ! Do not use FreeEOS tables if Q is less than this number;                 default: -10.0d0 |

/ ! end of eos namelist

&kap

!!! opacities
   Zbase = 1d-4                                                      ! base metallicity for opacity tables;                         default: -1      | set solar value
   
   kap_file_prefix = 'a09'                                           ! selects set of opacity tables;                               default: 'gs98'  |
   kap_lowT_prefix = 'lowT_fa05_a09p'                                ! selects set of low temperature opacity tables;               default: 'lowT_fa05_gs98'  |
   kap_CO_prefix = 'a09_co'                                          ! selects set of CO temperature opacity tables;                default: 'gs98_co'  |

/ ! end of kap namelist

&controls

   use_dPrad_dm_form_of_T_gradient_eqn = .true.                      ! enable to use a more dynimical equation to get temperature gradient; default: .false. |

   initial_mass = 0.7d0                                              ! initial mass in Msun;     default: 1      | only need for single star models
   initial_z = 1d-4                                                  ! initial metallicity;      default: 0.02d0 | can be any value in the range [0,0.04]
   initial_y = -1                                                    ! initial helium abundance; default: -1     | <0 means initial_y=0.24+2*initial_z

   max_abs_rel_run_E_err = -1

   photo_directory = 'photos1'                                       ! where to save photos;                           default: 'photos'            | use a different directory for each star
   log_directory = 'LOGS1'                                           ! where to save logs;                             default: 'LOGS'              | use a different directory for each star
   
   profile_interval = 10                                             ! interval for writing out profiles;              default: 50                  |
   max_num_profile_models = 100000                                   ! maximum number of saved profiles;               default: 100                 |
   terminal_interval = 10                                            ! interval for terminal outputs;                  default: 1                   |
   write_header_frequency = 100                                      ! frequency to repeat the header every X outputs; default: 10                  |
   photo_digits = 4                                                  ! number of digits in photo's filename;           default: 3                   | set in binary_controls
   photo_interval = 100                                              ! interval for writing photos;                    default: 50                  | set in binary_controls
   
   write_profiles_flag = .true.                                      ! enables to write out profiles;                  default: .true.              | no profiles

   Pextra_factor = 2.0d0                                             ! allows additional radiation pressure at tau=0;                               default: 1           | double it

   use_superad_reduction = .false.
   
   okay_to_reduce_gradT_excess = .false.                             ! enable MLT++;                                                                           default: .false. | use MLT++

   w_div_wcrit_max = 0.9d0

   hot_wind_scheme = 'Dutch'                                         ! hot wind scheme: hot of all stars;                                                                      default: ''      |
   cool_wind_RGB_scheme ='Dutch'                                     ! cool wind scheme: cool of high mass stars (Minit>10Msun);                                               default: ''      |
   cool_wind_AGB_scheme = 'Blocker'                                  ! cool wind scheme: cool for low mass stars in AGB;                                                       default: ''      |
   Dutch_scaling_factor = 0                                          ! scaling factor for Dutch wind scheme;                                                                   default: 0d0     |
   Blocker_scaling_factor = 0                                        ! scaling factor for Blocker wind scheme;                                                                 default: 0       |
   Reimers_scaling_factor = 0                                        ! scaling factor for Reimers wind scheme;                                                                 default: 0       |

   he_core_boundary_h1_fraction = 1d-2                               ! helium-core boundary at outermost location;                  default: 0.1d0 | requires X_H1<=this value

   mesh_delta_coeff = 2.0d0                                          ! coefficient to determine the difference between two zones before a new zone is requested;  default: 1.0d0 |
   solver_iters_timestep_limit = 20                                  ! maximum number of solver iterations before timestep gets reduced;                  default: 7       | old name: newton_iterations_limit

   ! for single stars stars, the control below needs to be true, so that the carbon exhaustion check happens in run_star_extras.f
   x_logical_ctrl(1) = .true.
   ! for formation of He single stars, before they later evolve in a CO-HeMS binary or in a He Star
   x_logical_ctrl(2) = .false.
   ! Turn on eq.8 Belczynski+2010 LBV2 winds  with factor 1 (10-4 Msun/yr) to replace other winds for postMS stars in Humphreys-Davidson limit
   x_logical_ctrl(3) = .false.
   ! allaow accretion as in Haemmerlé et al.(2016)
   x_logical_ctrl(4) = .true. 

   use_other_adjust_mdot = .true.                                    ! enable additional routine after wind and before mass adjustment; default: .false. |                                      

   ! multiplicative factor for the accretion rate given by Haemmerle et al. (2016)
   x_ctrl(6) = 10.0d0 

   ! turn on the hot accretion scheme by Kuffmeier et al. 2018, see eq. (1) there
   x_logical_ctrl(5) = .false.
   ! value of the epsilon parameter from eq. (1)
   x_ctrl(5) = 0.0d0  
   ! minimum radial coord. [Rsun] to deposit the heat from the accreted material          
   x_ctrl(7) = 10.0d0
   ! allow for energy injection during accretion
   use_other_energy = .false.                                        ! enable other energy prescription;                                default: .false. |

   !!! when to stop 
   star_mass_max_limit = 1.0d3   ! this should be the same as the relaxed mass (new_mass)

   


/ ! end of controls namelist

